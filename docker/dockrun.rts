docker build -t orcaopta-standalone .
docker run -p 8000:8000 \
  -e ORCAOPTA_MODE=standalone \
  -e ORCAOPTA_ROLE=api \
  -v ./mlruns:/app/mlruns \
  orcaopta-standalone


docker run \
  -e ORCAOPTA_MODE=standalone \
  -e ORCAOPTA_ROLE=trainer \
  -e TRAIN_SCRIPT=train_cpu \
  orcaopta-standalone


docker run -p 8000:8000 \
  -e ORCAOPTA_MODE=cluster \
  -e ORCAOPTA_ROLE=api \
  -e MLFLOW_TRACKING_URI=http://mlflow:5000 \
  orcaopta-standalone


curl -X POST http://localhost:8000/model/deploy \
  -F "family=anomaly" \
  -F "version=v3" \
  -F "file=@anomaly_v3.pkl"
Deploy autoscale model v2:
Code
curl -X POST http://localhost:8000/model/deploy \
  -F "family=autoscale" \
  -F "version=v2" \
  -F "file=@autoscale_v2.pkl"

wingetcreate submit \
  --token <PAT> \
  --manifest manifests/o/Orcaopta/Orcaopta/0.1.0/
